# WCode systemd 环境变量模板
# 复制到 /etc/wcode/wcode.env 并执行 `sudo chmod 600 /etc/wcode/wcode.env`

# 监听地址：配合本机 Nginx / Caddy 反向代理时保持 127.0.0.1；
# 若不经反代直接对外暴露端口，改为 0.0.0.0 并务必配置下方强随机令牌。
WCODE_SERVER_HOST=127.0.0.1
PORT=3030

# 默认工作区目录（启动后仍可在 Web 界面添加/切换服务器上其他有权限访问的本地目录）
WCODE_SERVER_WORKSPACE=/srv/workspace

# 应用数据基目录（会话、设置、登录态保存在其下的 .wcode/v2/）
WCODE_DATA_BASE_DIR=/var/lib/wcode

# 明确标记为远端服务端模式，关闭宿主机 GUI 文件管理器/编辑器入口
WCODE_DEPLOYMENT_MODE=server
WCODE_ALLOW_HOST_REVEAL=0

# 固定访问令牌（推荐用 `openssl rand -hex 24` 生成；未设置且监听非回环地址时自动生成一次性令牌并打印到 journalctl）
WCODE_SERVER_AUTH_TOKEN=replace-with-a-strong-random-token

# 无桌面 Linux 服务器缺少 DBus Secret Service 时，服务端启动需要 0600 权限的 32-4096 字节凭据加密密钥文件：
#   sudo install -d -m 700 -o wcode -g wcode /var/lib/wcode/.wcode/v2
#   sudo -u wcode sh -c 'umask 077 && openssl rand -out /var/lib/wcode/.wcode/v2/credential-secret 32'
# 也可通过下方变量指定自定义密钥文件路径（与默认路径二选一，不要同时设置 WCODE_CREDENTIAL_SECRET）：
# WCODE_CREDENTIAL_SECRET_FILE=/etc/wcode/credential-secret

# 可选：自定义本地模型 Provider JSON 文件路径（不登录官方账号时使用）
# WCODE_BUILTIN_PROVIDER_CONFIG_FILE=/etc/wcode/model-config.json

# 可选：若系统 PATH 中无 Node >= 24 且未安装私有 Node，可显式指定 Node 24+ 路径
# WCODE_NODE_BIN=/opt/wcode/node/current/bin/node
